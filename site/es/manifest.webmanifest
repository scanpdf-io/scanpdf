    },
    {
      "src": "../icons/icon-256.png",
      "sizes": "256x256",
      "type": "image/png"
    },
    {
      "src": "../icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
